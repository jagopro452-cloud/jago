{
  "name": "jago-staging",
  "region": "blr",
  "services": [
    {
      "name": "jago-staging-web",
      "github": {
        "repo": "jagopro452-cloud/jago",
        "branch": "release/preprod-hardening-2026-05-13-critical-fixes"
      },
      "build_command": "npm ci && npm run build",
      "run_command": "npm run start",
      "source_dir": "/",
      "http_port": 5000,
      "instance_size_slug": "basic-s",
      "instance_count": 1,
      "health_check": {
        "initial_delay_seconds": 30,
        "period_seconds": 30,
        "timeout_seconds": 10,
        "success_threshold": 1,
        "failure_threshold": 3,
        "http_path": "/api/health"
      },
      "envs": [
