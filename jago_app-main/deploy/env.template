# ============================================================
# Jago App — Environment Variables
# Copy this to /var/www/jago/.env and fill in your values
# ============================================================

NODE_ENV=production
PORT=5000

# ── Database (AWS RDS PostgreSQL) ──────────────────────────
# Format: postgresql://username:password@rds-endpoint:5432/jagoapp
DATABASE_URL=postgresql://jago:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT.rds.amazonaws.com:5432/jagoapp

# ── Session ────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_64_char_string

# ── SMS (smslogin.co) ─────────────────────────────────────
SMSLOGIN_USERNAME=jago123
SMSLOGIN_API_KEY=90e188232cf203b02e3a
SMSLOGIN_SENDER_ID=JAGOAP

# ── Razorpay ───────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Google Maps ────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_server_key

# ── Firebase (push notifications) ────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
